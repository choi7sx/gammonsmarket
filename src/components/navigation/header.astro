---
import Icon from "../market/Icon.astro";
const { header, business: b, pathname = "/" } = Astro.props;
---

<a href="#main" class="skip-link">
  Skip to content
</a>
<div class="announcement">
  <span data-editable="text" data-prop="business.announcement">
    {b.announcement}
  </span>
  <a href="/visit/">
    <Icon name="map-pin" size={13} />
    <span data-editable="text" data-prop="business.announcement_address">
      {b.announcement_address}
    </span>
    <Icon name="arrow-up-right" size={13} />
  </a>
</div>
<header class="site-header">
  <div class="wrap nav-inner">
    <a href={header.logo_url} class="brand" aria-label="Gammon’s Market home">
      <img
        src={header.logo}
        alt={header.logo_alt_text}
        width="458"
        height="458"
        data-editable="image"
        data-prop-src="header.logo"
        data-prop-alt="header.logo_alt_text"
      />
    </a>
    <nav
      class="desktop-nav"
      aria-label="Main navigation"
      data-editable="array"
      data-prop="header.links"
      data-direction="row"
    >
      {header.links.map((link: { link: string; text: string }) => (
        <span data-editable="array-item">
          <a
            href={link.link}
            aria-current={
              pathname.replace(/\/$/, "") === link.link.replace(/\/$/, "")
                ? "page"
                : undefined
            }
          >
            <span data-editable="text" data-prop="text">
              {link.text}
            </span>
          </a>
        </span>
      ))}
    </nav>
    <a
      href={b.order_url}
      class="button button-green nav-order"
      data-conversion="order"
    >
      <span data-editable="text" data-prop="header.order_label">
        {header.order_label}
      </span>
      <Icon name="arrow-up-right" size={17} />
    </a>
    <button
      type="button"
      class="mobile-menu"
      aria-label="Open navigation"
      aria-controls="market-menu"
      aria-expanded="false"
      data-menu-open
    >
      <Icon name="menu" />
    </button>
  </div>
</header>
<dialog
  id="market-menu"
  class="mobile-nav-panel"
  aria-labelledby="market-menu-title"
>
  <button
    type="button"
    class="mobile-nav-close"
    aria-label="Close navigation"
    data-menu-close
  >
    <Icon name="x" />
  </button>
  <h2 id="market-menu-title">Welcome to Gammon’s.</h2>
  <p>Your neighborhood market and café.</p>
  <nav aria-label="Mobile navigation">
    {header.links.map((link: { link: string; text: string }) => (
      <a href={link.link}>
        {link.text}
        <Icon name="arrow-up-right" size={21} />
      </a>
    ))}
    <a href="/gift-baskets/">
      Gift baskets
      <Icon name="arrow-up-right" size={21} />
    </a>
    <a href="/contact/">
      Get in touch
      <Icon name="arrow-up-right" size={21} />
    </a>
  </nav>
  <a href={b.order_url} class="button button-green">
    {header.order_label}
    <Icon name="arrow-up-right" size={18} />
  </a>
</dialog>
<noscript>
  <nav class="noscript-nav" aria-label="Navigation">
    {header.links.map((link: { link: string; text: string }) => (
      <a href={link.link}>{link.text}</a>
    ))}
  </nav>
</noscript>
